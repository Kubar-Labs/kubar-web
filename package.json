{
  "name": "kubar-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "agentation": "agentation-mcp server",
    "build": "next build --webpack",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:consumer": "wrangler deploy --config workers/contact-email/wrangler.jsonc",
    "deploy:cf": "npm run release:check && npm run deploy:consumer && opennextjs-cloudflare deploy",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build:cf",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --env-file .env.example",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
